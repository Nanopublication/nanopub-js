{
  "name": "@nanopub/nanopub-js",
  "version": "0.5.0",
  "type": "module",
  "main": "./dist/node.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "packageManager": "yarn@4.18.1",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "default": "./dist/nanopub.bundle.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nanopublication/nanopub-js"
  },
  "license": "MIT",
  "scripts": {
    "build": "vite build && vite build --mode bundle && vite build --mode node",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --coverage",
    "test:package": "yarn build && yarn pack -o tests/package/nanopub-js.tgz && cd tests/package && rm -rf node_modules/@nanopub && npm install && npm test",
    "prepare": "yarn run build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nanopub/nanopub-testsuite-connector-js": "^1.0.0",
    "@types/n3": "^1",
    "@types/node": "^24.9.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^20.0.11",
    "prettier": "^3.7.4",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.53.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "@traqula/parser-sparql-1-1": "^1.2.1",
    "n3": "^2.0.0"
  }
}
